# ═══════════════════════════════════════════════════════════════════════════
# UshaMart — User Frontend Environment Variables
# ═══════════════════════════════════════════════════════════════════════════
# HOW TO USE:
#   • Local dev:    Copy to .env — leave VITE_API_URL empty (Vite proxy handles /api)
#   • Production:   Set as Netlify / Vercel build environment variables
#                   Netlify: Site → Site Configuration → Environment Variables
#
# IMPORTANT:
#   • NEVER add SUPABASE_SERVICE_ROLE_KEY here — that belongs only in the backend.
#   • Firebase config values below are PUBLIC and safe to ship in the browser bundle.
#   • The user portal communicates ONLY through the Express backend API for data.
#     Firebase is used exclusively for user authentication (sign-in/sign-up).
# ═══════════════════════════════════════════════════════════════════════════

# ── Backend API URL ───────────────────────────────────────────────────────────
# The bare origin of the Admin Backend (no trailing slash, no /api suffix).
# The user frontend automatically appends /api — see src/services/api.js.
#
# Local dev  → leave empty; Vite proxy forwards /api → http://localhost:5000
# Production → your Render/Railway backend URL
# IMPORTANT: BOTH admin and user portals must point to the SAME backend URL.
VITE_API_URL=https://ushamart.onrender.com

# ── Firebase (User Authentication only — PUBLIC values) ──────────────────────
# Firebase Console → Project Settings → General → Web app → Config
# These values are safe to include in the browser bundle.
VITE_FIREBASE_API_KEY=AIzaSyCu28CkdYM7CocnqFXXNRefC3o2_IkfM54
VITE_FIREBASE_AUTH_DOMAIN=ushamart-wholesale.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ushamart-wholesale
VITE_FIREBASE_STORAGE_BUCKET=ushamart-wholesale.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=584917547503
VITE_FIREBASE_APP_ID=1:584917547503:web:a4e67c750c3c5d243e1e1a
VITE_FIREBASE_MEASUREMENT_ID=G-2V7XR1G7P1
