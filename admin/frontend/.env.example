# ═══════════════════════════════════════════════════════════════════════════
# UshaMart — Admin Frontend Environment Variables
# ═══════════════════════════════════════════════════════════════════════════
# HOW TO USE:
#   • Local dev:    Copy to .env — leave VITE_API_URL empty (Vite proxy handles /api)
#   • Production:   Set as Netlify / Vercel build environment variables
#                   Netlify: Site → Site Configuration → Environment Variables
#
# IMPORTANT:
#   • NEVER add SUPABASE_SERVICE_ROLE_KEY or Firebase private keys here.
#     Those belong ONLY in the backend runtime environment.
#   • The admin frontend communicates exclusively through the Express backend API.
#     It never talks to Supabase directly.
# ═══════════════════════════════════════════════════════════════════════════

# ── Backend API URL ───────────────────────────────────────────────────────────
# The bare origin of the Admin Backend (no trailing slash, no /api suffix).
# The admin frontend automatically appends /api — see src/services/api.js.
#
# Local dev  → leave empty; Vite proxy forwards /api → http://localhost:5000
# Production → your Render/Railway backend URL
# IMPORTANT: BOTH admin and user portals must point to the SAME backend URL.
VITE_API_URL=https://ushamart.onrender.com

# ── Mappls (MapmyIndia) — pincode map lookup (optional) ──────────────────────
# Used in admin pincode management for map preview. Leave empty to disable.
VITE_MAPPLS_API_KEY=YOUR_MAPPLS_API_KEY
