# ── Admin Frontend Environment Variables ────────────────────────────────────
# Copy this file to .env.local (development) or set in Netlify (production)
# The admin application talks only to the backend API. Do not add Supabase
# credentials or service-role keys to this browser application.

# ── Backend API ───────────────────────────────────────────────────────────────
# Development: Vite proxy handles /api → http://localhost:5000
# Production (Netlify): Set to your deployed backend URL
# Example: https://ushamart-admin-backend.onrender.com
# Get from: Render Dashboard → Your service → URL
VITE_API_URL=https://YOUR_BACKEND_DOMAIN

# ── Supabase (Public Anon Key Only) ──────────────────────────────────────────
# Get from: Supabase Dashboard → Settings → API
# VITE_SUPABASE_URL: Project URL
# VITE_SUPABASE_ANON_KEY: anon public key (safe to expose)
# NOTE: This key is PUBLIC — only grants read access to public data

# ── Mappls (MapmyIndia) API ──────────────────────────────────────────────────
# Get from: https://mappls.com/api/dashboard
# Used for location services and map integration
VITE_MAPPLS_API_KEY=YOUR_MAPPLS_API_KEY

# ────────────────────────────────────────────────────────────────────────────
# PRODUCTION SETUP IN NETLIFY
# ────────────────────────────────────────────────────────────────────────────
# 1. Go to Netlify Dashboard → Site settings → Environment
# 2. Add these environment variables with actual values:
#    - VITE_API_URL: https://your-backend-url.onrender.com
#    - VITE_SUPABASE_URL: https://your-project-id.supabase.co
#    - VITE_SUPABASE_ANON_KEY: your-public-key
#    - VITE_MAPPLS_API_KEY: your-api-key
# 3. Trigger a new deploy for changes to take effect
