# ── Node.js / Backend ────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment files — NEVER commit secrets
backend/.env
backend/firebase-service-account.json

# Database data files (local JSON fallback — not for production)
backend/src/database/data/*.json
!backend/src/database/data/.gitkeep

# Uploaded images (served at runtime)
backend/uploads/*
!backend/uploads/.gitkeep

# Build output
backend/dist/
frontend/dist/

# ── Vite / React Frontend ─────────────────────────────────────────────────────
frontend/node_modules/
frontend/.env
frontend/.env.local
frontend/.env.production

# ── OS / Editor ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
*.log
*.tmp
*.swp
