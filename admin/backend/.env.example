# ═══════════════════════════════════════════════════════════════════════════
# UshaMart — Admin Backend Environment Variables
# ═══════════════════════════════════════════════════════════════════════════
# HOW TO USE:
#   • Local dev:  Copy to .env and fill in all values, then run: npm run dev
#   • Production: Set these as environment variables in your hosting (Render, Railway, etc.)
#   • NEVER commit the real .env file — it is in .gitignore
#
# CRITICAL: SUPABASE_SERVICE_ROLE_KEY must NEVER appear in any frontend code.
# It belongs ONLY in this backend runtime environment.
# ═══════════════════════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# This SAME value must be used on every backend instance and never change.
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING_MIN_32_CHARS
JWT_EXPIRES_IN=7d

# ── Supabase (Backend Only — NEVER in frontend) ───────────────────────────────
# Dashboard → Your Project → Settings → API
#   SUPABASE_URL:              "Project URL"  e.g. https://xkooguvxhh.supabase.co
#   SUPABASE_SERVICE_ROLE_KEY: "service_role" key (bypasses RLS — backend only)
#
# BOTH portals (Admin + User) connect to this SAME Supabase project via this backend.
# The frontend NEVER talks to Supabase directly for data — only through this API.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJYOUR_SERVICE_ROLE_KEY_HERE

# ── Firebase Admin SDK (user authentication verification) ─────────────────────
# Required to verify Firebase ID tokens from the user portal.
# Firebase Console → Project Settings → Service Accounts → Generate New Key
# Paste the entire JSON as a single-line string:
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"YOUR_PROJECT","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"..."}

# ── Firebase Storage (legacy — for old image URL compatibility) ───────────────
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app

# ── Mappls (MapmyIndia) — pincode geocoding (optional) ────────────────────────
# Leave empty to disable geocoding. Pincodes still work without this.
MAPPLS_API_KEY=YOUR_MAPPLS_API_KEY

# ── CORS — additional allowed origins ────────────────────────────────────────
# Defaults already include: localhost:*, *.netlify.app, ushamart.onrender.com
# Add your custom domains here (comma-separated):
CORS_ORIGINS=https://your-user-app.netlify.app,https://your-admin-app.netlify.app

# ── Admin Bootstrap Credentials ───────────────────────────────────────────────
# Used ONLY on first startup to create the super-admin if none exists.
# Change the password immediately after first login.
ADMIN_EMAIL=admin@ushamart.in
ADMIN_PASSWORD=CHANGE_THIS_STRONG_PASSWORD_BEFORE_DEPLOYING

# ── Local Development Mode ────────────────────────────────────────────────────
# Set USE_LOCAL_DB=true ONLY for local dev without a Supabase project.
# MUST be false (or absent) in production.
# USE_LOCAL_DB=false
