# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a secure random string for production (min 32 chars)
# Example: openssl rand -base64 32
JWT_SECRET=YOUR_JWT_SECRET_REPLACE_WITH_LONG_RANDOM_STRING
JWT_EXPIRES_IN=7d

# ── Supabase Database (Backend Only) ──────────────────────────────────────────
# Get these from your Supabase project dashboard
# SUPABASE_URL: Settings → API → Project URL
# The backend needs a server-only service role key for protected checkout
# writes. Never expose this value in either frontend application.
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ── Firebase Storage (image uploads) ─────────────────────────────────────────
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app

# ── Mappls (MapmyIndia) API ──────────────────────────────────────────────────
# Get from: https://mappls.com/api/dashboard
MAPPLS_API_KEY=YOUR_MAPPLS_API_KEY

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=https://YOUR_USER_APP_DOMAIN,https://YOUR_ADMIN_APP_DOMAIN

# ── Admin Credentials (NEVER commit actual values) ────────────────────────────
# For development only. Render environment variables override these.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_THIS_IN_RENDER
